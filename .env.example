# Realtime Translate Mobile local placeholder contract.
# Do not put real secrets in this file.

# App/runtime
APP_ENV=local
OPENAI_REALTIME_MODEL=gpt-realtime-translate
TOKEN_BROKER_BASE_URL=http://localhost:3001

# Android/auth placeholders
ANDROID_PACKAGE_NAME=com.example.realtimetranslate
MICROSOFT_CLIENT_ID=replace-with-microsoft-public-client-id
MICROSOFT_TENANT=common
GOOGLE_ANDROID_CLIENT_ID=replace-with-google-android-client-id

# AWS token broker placeholders
AWS_REGION=us-east-1
TOKEN_BROKER_ALLOWED_AUDIENCE=replace-with-expected-app-audience
TOKEN_BROKER_CLIENT_SECRET_TTL_SECONDS=60

# Backend/Lambda local-only secret placeholder.
# Never copy this value into mobile code, mobile config, assets, tests, or build outputs.
BACKEND_OPENAI_API_KEY=replace-with-backend-only-standard-openai-api-key
