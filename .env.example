# Realtime Translate Mobile local placeholder contract.
# Do not put real secrets in this file.

# App/runtime
APP_ENV=local
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_TRANSLATION_FALLBACK_MODEL=gpt-realtime-translate

# Summary export product intent.
# Verify current OpenAI API model and reasoning-parameter support before coding.
OPENAI_SUMMARY_MODEL_INTENT=gpt-5.5
OPENAI_SUMMARY_REASONING_INTENT=xhigh

# Android placeholders
ANDROID_PACKAGE_NAME=com.tomdf47.realtime_translate_mobile

# Intentionally omitted:
# - OPENAI_API_KEY or any OpenAI credential/session material
# - AWS/Lambda/token-broker values
# - Google/Microsoft sign-in values
# - signing keys, keystores, cookies, account IDs, or tokens
